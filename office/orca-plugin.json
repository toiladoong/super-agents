{
  "manifestVersion": 2,
  "id": "super-agents-office",
  "name": "Agent Office",
  "version": "0.9.2",
  "description": "Văn phòng pixel cho các agent đang chạy trong Orca (kèm thú nuôi và cây trồng), và trình sửa trực quan team.json của super-agents (vai, AI, model, luật repo).",
  "engines": {
    "orca": ">=1.4.248"
  },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "contributes": {
    "panels": [
      {
        "id": "office",
        "title": "Agent Office",
        "icon": "bot",
        "entry": "panel/index.html"
      }
    ],
    "customEditors": [
      {
        "id": "team",
        "title": "Team",
        "filenames": [
          "team.json",
          "team.default.json"
        ],
        "entry": "team-editor/index.html",
        "priority": "option"
      }
    ],
    "settings": [
      {
        "key": "language",
        "title": "Ngôn ngữ / Language",
        "description": "Ngôn ngữ của panel Agent Office và editor Team khi team.json của workspace chưa đặt \"language\". / Language of the Agent Office panel and the Team editor when the workspace's team.json sets no \"language\".",
        "type": "string",
        "default": "vi",
        "enum": [
          "vi",
          "en"
        ],
        "enumLabels": [
          "Tiếng Việt",
          "English"
        ]
      }
    ]
  },
  "capabilities": [
    {
      "kind": "agent:read"
    },
    {
      "kind": "workspace:read"
    },
    {
      "kind": "workspace:write"
    },
    {
      "kind": "settings:own"
    },
    {
      "kind": "storage:own"
    }
  ],
  "main": "worker/main.ts"
}
